{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "azure-oss/storage-blob-laravel": "^2.2",
        "guzzlehttp/guzzle": "^7.10",
        "intervention/image": "^4.3",
        "jaybizzle/laravel-crawler-detect": "^2.1",
        "kyslik/column-sortable": "^8.0",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.35",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-ftp": "^3.36",
        "makingcg/saas-billing": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-tail": "^4.6",
        "stechstudio/laravel-zipstream": "^5.10",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/mailgun-mailer": "^7.4|^8.0",
        "symfony/postmark-mailer": "^7.4|^8.0",
        "teamtnt/laravel-scout-tntsearch-driver": "^16.2"
    },
    "require-dev": {
        "ext-json": "*",
        "barryvdh/laravel-ide-helper": "^3.7",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/saas-billing",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/",
            "Domain\\": "src/Domain/",
            "Support\\": "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds"
        ],
        "files": [
            "src/Support/errors.php",
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    }
}
