APP_NAME=VueFileManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DEMO=false

LOG_CHANNEL=daily
LOG_LEVEL=debug

SCOUT_DRIVER=tntsearch
SCOUT_QUEUE=true

FILESYSTEM_DISK=local

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vuefilemanager
DB_USERNAME=vuefilemanager
DB_PASSWORD=secret
DB_MYSQLDUMP_PATH=/usr/bin

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=15120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@vuefilemanager.test"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=vuefilemanager
REVERB_APP_KEY=vuefilemanager-key
REVERB_APP_SECRET=vuefilemanager-secret
# Where Laravel (inside Docker) reaches the Reverb server
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the browser reaches the Reverb server
REVERB_FRONTEND_HOST=localhost
REVERB_FRONTEND_PORT=8080
REVERB_FRONTEND_SCHEME=http

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

IS_ADMIN_VUEFILEMANAGER_BAR=true
IS_SETUP_WIZARD_DEMO=false
IS_SETUP_WIZARD_DEBUG=false
